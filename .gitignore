# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Nested duplicate -- should not be committed
GYM-ERP-2/

# Local agent skills & assistant configs
.agents/

# MCP server build output
mcp-server/dist/
mcp-server/node_modules/

# Hardware bridge
hardware-bridge/dist/
hardware-bridge/node_modules/

# Python cache (CCTV service)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Temporary patch scripts
patch*.js

# Desktop / Tauri build output
desktop/src-tauri/target/
desktop/dist/
desktop/node_modules/

# WhatsApp bridge
whatsapp-bridge/node_modules/
whatsapp-bridge/dist/
whatsapp-bridge/data/
whatsapp-bridge/bin/

# Android Kiosk build output
android-kiosk/node_modules/
android-kiosk/dist/
android-kiosk/android/app/build/
android-kiosk/android/.gradle/
android-kiosk/android/build/
android-kiosk/.capacitor/

# Android Manager build output
android-manager/node_modules/
android-manager/dist/
android-manager/android/app/build/
android-manager/android/.gradle/
android-manager/android/build/
