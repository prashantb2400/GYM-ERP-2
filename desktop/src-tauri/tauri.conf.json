{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "GymERP",
  "version": "1.0.0",
  "identifier": "com.gymerp.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GymERP",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http: https: ws: wss:; script-src 'self' 'unsafe-eval' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:;"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "GymERP Manager & WhatsApp Bridge",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/baileys-engine",
      "bin/cloudflared"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.gymerp.com/desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "YOUR_ED25519_PUBLIC_KEY"
    }
  }
}
