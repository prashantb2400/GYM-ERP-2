{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0",
  "description": "Antigravity 2.0 MCP Strategy and Tool Access Configuration",
  "servers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "description": "Repository inspection, branch creation, commit creation, and draft PR generation",
      "permissions": {
        "auto_approved": ["read_repository", "read_issues", "create_branch", "create_commit", "open_draft_pr"],
        "human_approval_required": ["merge_pr", "push_to_main", "delete_branch", "update_security_settings"]
      },
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-playwright"],
      "enabled": true,
      "description": "Headless browser automation for UI verification, DOM assertions, and interaction verification",
      "permissions": {
        "auto_approved": ["navigate", "click", "fill", "screenshot", "evaluate_script"],
        "human_approval_required": ["external_site_navigation", "file_download"]
      }
    },
    "database": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "enabled": false,
      "description": "Scoped local/development database access",
      "permissions": {
        "auto_approved": ["select_dev", "describe_table_dev"],
        "human_approval_required": ["drop_table", "truncate_table", "raw_delete", "production_access"]
      }
    },
    "gymerp": {
      "command": "node",
      "args": ["mcp-server/dist/index.js"],
      "enabled": true,
      "description": "GymERP SaaS operational intelligence: member management, attendance check-ins, GST billing, and lead CRM",
      "permissions": {
        "auto_approved": ["gym_search_members", "gym_get_member", "gym_get_attendance_logs", "gym_get_live_occupancy", "gym_list_plans", "gym_get_dues", "gym_list_leads", "gym_get_overview"],
        "human_approval_required": ["gym_create_member", "gym_update_member", "gym_record_attendance", "gym_create_invoice", "gym_capture_lead", "gym_update_lead"]
      },
      "env": {
        "NEXT_PUBLIC_SUPABASE_URL": "${NEXT_PUBLIC_SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}",
        "GYMERP_GYM_ID": "${GYMERP_GYM_ID}"
      }
    }
  }
}
